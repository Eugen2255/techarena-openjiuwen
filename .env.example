# Скопируйте в .env и впишите свой ключ. Файл .env не коммитится.
LLM_BASE_URL=https://api.neuraldeep.ru/v1
LLM_API_KEY=

# Бюджет токенов (out + in/10). Организаторы передают его в BUDGET; без него харнесс берёт 100000.
# BUDGET=100000

# Зеркало PyPI для локальной сборки образа, если pypi.org качает медленно.
# У организаторов не используется.
# DEV_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Необязательные настройки для локальных экспериментов.
# На официальном прогоне они НЕ передаются — там работают значения по умолчанию из harness/config.py.
# HARNESS_MODEL=qwen3.8-27b-noreason
# HARNESS_WORKERS=5
# HARNESS_MAX_STEPS=6
# HARNESS_TASK_TOKEN_CAP=6000
